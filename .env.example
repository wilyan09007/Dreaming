# Every secret the project reads. Copy to .env (git-ignored); mock-dir/.env.example is the same list.
# Where to get each one is in the comment. Nothing here is optional for the full demo except the two marked optional.

# --- frontier teachers (live moments; the recorded ledger is made with these once) ---
OPENROUTERKEY=            # https://openrouter.ai/settings/keys  (existing key; ~$42 of its $50 limit left)
ASI1KEY=                  # https://asi1.ai  -> Developer -> API keys (existing key)

# --- ASI:One front door ---
AGENTVERSEKEY=            # https://agentverse.ai -> Profile -> API keys (existing key)
AGENT_SEED=               # any long secret phrase you choose; the agent's address derives from it. Keep it forever:
                          # the Agentverse mailbox is bound to the address this seed produces

# --- database + live feed (Supabase, free tier) ---
# Create a project at https://supabase.com/dashboard/projects, then Project Settings:
DATABASE_URL=             # Settings -> Database -> Connection string -> "Session pooler" (port 5432, IPv4): postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_URL=             # Settings -> API -> Project URL: https://<ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY= # Settings -> API keys -> "Publishable key" (sb_publishable_...). Browser-safe: read-only on 4 tables via RLS

# --- training jobs (Modal, Starter plan: $30/month credit) ---
# Sign up at https://modal.com/signup, then `modal token new` (writes ~/.modal.toml) or create a token at https://modal.com/settings/tokens
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# --- always-on API + agent (Fly.io, ~ $10/month, needs a card) ---
# Sign up at https://fly.io/app/sign-up, add a card, then `fly tokens create org -x 720h` (or https://fly.io/user/personal_access_tokens)
FLY_API_TOKEN=

# --- optional ---
LOGFIRE_TOKEN=            # https://logfire.pydantic.dev -> project -> Write tokens. Unset: JSON logs to stdout only
RUNPODKEY=                # only for the feasibility smokes in smokes/ (pod.py); the demo does not use RunPod
