# Names only; values live in ../.env locally (git-ignored; the full list with sign-up links is ../.env.example),
# on Fly via `fly secrets set --stage`, on Modal via `modal secret create dreaming-db DATABASE_URL=...`.

# teachers: one key per provider row in teachers.PROVIDERS; every key that is set is usable, the call site's TeacherSpec picks the row
OPENROUTERKEY=
ASI1KEY=
STEPFUNKEY=                  # platform.stepfun.ai -> Interface Keys, after redeeming the LA Hacks voucher (docs/devtools.md)
GEMINIKEY=                   # aistudio.google.com/apikey

# ASI:One front door
AGENTVERSEKEY=
AGENT_SEED=                  # the uAgent's identity; the mailbox is bound to the address this seed produces

# Supabase
DATABASE_URL=                # session pooler (IPv4), port 5432
SUPABASE_URL=                # https://<ref>.supabase.co (the page reads this and the publishable key from /state)
SUPABASE_PUBLISHABLE_KEY=    # sb_publishable_... : browser, role anon, read-only on 4 tables

# Modal
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Fly.io (deploys only; not read by the apps)
FLY_API_TOKEN=

# optional
LOGFIRE_TOKEN=
SENTRY_DSN=                  # sentry.io project -> Client Keys; SENTRY_TRACES=0.05 for batches (docs/devtools.md)

# settings, not secrets
TEACHER=openrouter           # openrouter | asi1 | stepfun | rule (offline dev): which spec the bookkeeper workflow pins
TRAINER=local                # local | modal
ENCODER_REV=5c38ec7c405ec4b44b94cc5a9bb96e735b38267a
RECORDED_ANSWERS=data/recorded.jsonl
EMBEDDING_CACHE=data/embeddings.npz
BUDGET=0.05
